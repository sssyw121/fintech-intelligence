# fintech-intelligence 환경변수 설정
# 이 파일을 복사하여 .env로 저장한 뒤 실제 값을 입력하세요:
#   cp .env.example .env

# ─── 텔레그램 봇 설정 ────────────────────────────────────────────────────────
# 1. @BotFather 에서 /newbot 명령으로 봇 생성
# 2. 발급받은 토큰을 아래에 입력
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 메시지를 받을 채팅 ID
# 개인 채팅: @userinfobot 에게 메시지를 보내면 확인 가능
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Anthropic Claude API (선택) ─────────────────────────────────────────────
# 설정 시: 뉴스 분석 품질 향상 (AI 기반 인사이트) + 자유 질문 AI 답변
# 미설정 시: 키워드 기반 분석으로 대체 (기본 동작)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
