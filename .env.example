# fintech-intelligence 환경변수 설정
# 이 파일을 복사하여 .env로 저장한 뒤 실제 값을 입력하세요:
#   cp .env.example .env

# ─── 텔레그램 봇 설정 ────────────────────────────────────────────────────────
# 1. @BotFather 에서 /newbot 명령으로 봇 생성
# 2. 발급받은 토큰을 아래에 입력
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 메시지를 받을 채팅 ID
# 개인 채팅: @userinfobot 에게 메시지를 보내면 확인 가능
# 그룹 채팅: 봇을 추가 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 확인
TELEGRAM_CHAT_ID=your_chat_id_here
